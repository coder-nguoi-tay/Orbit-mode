---
const links = [
  ['GitHub', 'https://github.com/coder-nguoi-tay/Orbit-mode'],
  ['Releases', 'https://github.com/coder-nguoi-tay/Orbit-mode/releases'],
  ['Issues', 'https://github.com/coder-nguoi-tay/Orbit-mode/issues'],
];
---

<footer class="footer" id="footer">
  <div>
    <strong>Orbit-mode</strong>
    <span>Desktop AI agent dashboard. MIT licensed.</span>
  </div>
  <nav aria-label="Footer navigation">
    {links.map(([label, href]) => <a href={href}>{label}</a>)}
  </nav>
</footer>

<style>
  .footer {
    align-items: center;
    border-top: 1px solid rgba(244, 239, 228, 0.12);
    display: flex;
    justify-content: space-between;
    margin-top: 72px;
    padding: 30px 0 0;
    width: 100%;
  }

  .footer div {
    display: grid;
    gap: 4px;
  }

  .footer strong {
    color: var(--text);
    font-family: var(--display);
    font-size: 18px;
  }

  .footer span,
  .footer a {
    color: var(--quiet);
  }

  .footer nav {
    display: flex;
    gap: 18px;
  }

  .footer a {
    transition: color 0.18s var(--ease);
  }

  .footer a:hover {
    color: var(--green);
  }

  @media (max-width: 640px) {
    .footer {
      align-items: flex-start;
      flex-direction: column;
      gap: 18px;
      padding-top: 28px;
    }

    .footer nav {
      flex-wrap: wrap;
    }
  }
</style>
